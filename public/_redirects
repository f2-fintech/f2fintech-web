# Redirect old terms URL (with & character) to clean URL
/terms-&-condition  /terms-and-condition  301!

# Force HTTPS and non-www canonical
http://f2fintech.com/*   https://f2fintech.com/:splat  301!
http://www.f2fintech.com/*  https://f2fintech.com/:splat  301!
https://www.f2fintech.com/* https://f2fintech.com/:splat  301!

# Static files - serve directly, do NOT redirect to index.html
/sitemap.xml        /sitemap.xml        200
/sitemap.xsl        /sitemap.xsl        200
/robots.txt         /robots.txt         200

# SPA fallback - must be last
/*    /index.html   200
